## Imperial City — Qbox Lean RP
## Generated by the imperial-city-qbox recipe. txAdmin replaces {{variables}}.

{{serverEndpoints}}
sv_maxclients {{maxClients}}
set steam_webApiKey "none"
sets tags "roleplay, qbox, imperial-city"

sv_licenseKey "{{svLicense}}"
sv_hostname "{{serverName}}"
sets sv_projectName "[{{recipeName}}] {{serverName}}"
sets sv_projectDesc "{{recipeDescription}}"
sets locale "en-AU"
load_server_icon myLogo.png
set sv_enforceGameBuild 3258
set mysql_connection_string "{{dbConnectionString}}"

# Chat
set resources_useSystemChat true
set qbx_chat:joinMessage "^2%s joined the city"
set qbx_chat:quitMessage "^1%s left the city (%s)"

# Voice
exec voice.cfg

# ── Qbox core configuration ─────────────────────────────────────────────
setr qb_locale "en"
setr qbx:enableBridge "true"          # required only by illenium-appearance + Renewed-Banking
set qbx:enableQueue "true"
set qbx:bucketLockdownMode "inactive"
set qbx:discordLink "discord.gg/CHANGE_ME"
set qbx:max_jobs_per_player 1
set qbx:max_gangs_per_player 1
set qbx:setjob_replaces "true"
set qbx:setgang_replaces "true"
set qbx:cleanPlayerGroups "true"
set qbx:allowMethodOverrides "true"
set qbx:disableOverrideWarning "false"
setr qbx:enableVehiclePersistence "false"
setr qbx:vehiclePersistenceType "semi"
set qbx:acknowledge "false"
setr qbx:enableGroupManagement "false"

setr illenium-appearance:locale "en"
setr weather_disablecd true

exec ox.cfg
exec economy.cfg

# Phone
set npwd:framework "qbx"
set SCREENSHOT_BASIC_TOKEN ""
set NPWD_AUDIO_TOKEN ""

setr loadscreen:externalShutdown true
set loadscreen:primaryColor "#f1e542"
set loadscreen:shadowColor "#1a18077f"

# Imperial suite convars
set imperial:debug "false"
set imperial:webhook_audit ""          # optional Discord webhook for audit mirror; DB is authoritative
setr imperial:currencyLocale "en-AU"

# ── Deterministic startup order ─────────────────────────────────────────
# Tier 0: cfx defaults
ensure mapmanager
ensure chat
ensure spawnmanager
ensure sessionmanager
ensure hardcap
ensure baseevents

# Tier 1: database + library + framework core
ensure oxmysql
ensure ox_lib
ensure qbx_core

# Tier 2: interaction + inventory (before anything that registers targets/stashes)
ensure ox_target
ensure ox_inventory

# Tier 3: remaining ox, framework satellites, world, voice
ensure [ox]
ensure [qbx]
ensure [standalone]
ensure [appearance]
ensure [voice]
# Maps and MLOs live in [mlo], NOT in [maps], and the name is load-bearing.
#
# Resource-category names are matched by folder name anywhere in the tree, and
# cfx-server-data ships its own [cfx-default]/[gamemodes]/[maps]/. So
# `ensure [maps]` also started fivem-map-hipster/fivem-map-skater, which declare
# `resource_type 'map' { gameTypes = { ['basic-gamemode'] = true } }` and
# therefore dragged in the Freeroam gametype. basic-gamemode then calls
# spawnmanager:setAutoSpawn(true) + forceRespawn() on onClientMapStart, which
# fights qbx_core's multicharacter spawn flow.
#
# Naming our folder [mlo] sidesteps that collision entirely -- nothing in
# cfx-server-data is called [mlo] -- so the whole category can be ensured at
# once and any map dropped into it starts without editing this file. That is
# what the old `ensure pillbox` line could not do.
# (The `stop basic-gamemode` above is a no-op: it runs before the resource has
# been started, so it stops nothing. Kept as documentation of the failed fix.)
ensure [mlo]

# Tier 4: phone
ensure qbx_npwd
ensure npwd
ensure [phone]

# Tier 5: housing, jobs, criminal content (framework consumers)
ensure [housing]
ensure [civilian-jobs]
ensure [criminal]

# Tier 6: imperial suite — logging first (shared base), dispatch before its consumers
# Shared streamed assets first: props must be registered before anything
# tries to spawn them.
ensure imperial_assets
ensure imperial_logging
ensure imperial_character
ensure imperial_dispatch
ensure imperial_crafting
ensure imperial_businesses
ensure imperial_farming
ensure imperial_gangs
ensure imperial_turfs
ensure imperial_drugs
ensure imperial_blackmarket
ensure imperial_boosting
ensure imperial_sidejobs
ensure imperial_fire
ensure imperial_mdt

# Housing shell support: suppresses outdoor rain/snow inside prop shells by
# using Renewed-Weathersync's own per-player syncWeather override.
ensure imperial_shells

# Dev tool: prop picker for choosing models for activity sites (/prop, /propnext).
# Client-side and non-networked. Remove this line to disable.
ensure imperial_propcheck

exec misc.cfg

{{addPrincipalsMaster}}
exec permissions.cfg
