# Imperial City — environment reference
#
# This recipe deploys through txAdmin, which supplies its own {{variable}}
# substitutions at deploy time (see recipes/imperial-city-qbox.yaml and
# docs/02-installation.md) — nothing in this project reads a real .env file
# at server runtime. This file exists as a single place documenting every
# secret/value an operator needs to have ready before running the deployer,
# and as the expected input format for any local tooling (e.g. a future CI
# script) that might want to connect to the same database outside of
# FXServer itself.
#
# Copy this to .env and fill in real values for LOCAL TOOLING USE ONLY.
# Never commit a real .env file — it is already excluded in .gitignore.

# ── Server identity (entered in txAdmin's deployer UI, not read from here) ──
SERVER_NAME="Imperial City RP"
MAX_CLIENTS=64
SV_LICENSE_KEY=

# ── Database (entered in txAdmin's deployer UI as a connection string;
#    listed individually here for local tooling that needs discrete values) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=imperial_city
DB_USER=imperial
DB_PASSWORD=

# ── Optional integrations ──
# Discord webhook URL for the imperial_logging audit mirror. Leave blank to
# rely on the database-only log (which is authoritative regardless).
# Set as the imperial:webhook_audit convar in server.cfg, not here.
IMPERIAL_WEBHOOK_AUDIT=

# ── Source repo used by the txAdmin recipe's download_github task ──
# Must point at your own fork — see docs/02-installation.md.
IMPERIAL_RECIPE_REPO=https://github.com/YOUR_ORG/imperial-city
